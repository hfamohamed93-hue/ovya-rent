---
import { Image } from "astro:assets";
import { categorieImage } from "../lib/categorie-image";
import { getVehiculePhoto } from "../lib/vehicule-image";
import type { CollectionEntry } from "astro:content";
import { t, type Locale } from "../lib/i18n";

interface Props {
  vehicule: CollectionEntry<"vehicules">;
  locale?: Locale;
}

const { vehicule, locale = "fr" } = Astro.props;
const { id, data } = vehicule;
const { marque, modele, categorie, transmission, carburant, places, prixParJourMAD, prixParJourEUR } = data;
const image = getVehiculePhoto(data.photo) ?? categorieImage[categorie];
const estPremium = prixParJourMAD >= 3000;
const strings = t(locale);
---

<article
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-noir-profond/[0.06] bg-blanc-pur shadow-[0_2px_14px_-6px_rgba(17,17,17,0.1)] transition-all duration-500 ease-out hover:-translate-y-2.5 hover:shadow-premium"
  data-categorie={categorie}
  data-transmission={transmission}
  data-carburant={carburant}
  data-prix={prixParJourMAD}
>
  <span class="pointer-events-none absolute inset-0 z-10 rounded-2xl opacity-0 ring-1 ring-dore-premium/40 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true" />
  <a href={`/vehicule/${id}`} class="relative block overflow-hidden">
    <Image
      src={image}
      alt={`${marque} ${modele}`}
      width={400}
      height={240}
      class="h-48 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-noir-profond/25 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
    <div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
      {estPremium && (
        <span class="glass-panel rounded-full px-2.5 py-1 font-body text-[10px] font-semibold uppercase tracking-wide text-dore-premium">
          {strings.carCard.premium}
        </span>
      )}
      {transmission === "Automatique" && (
        <span class="glass-panel rounded-full px-2.5 py-1 font-body text-[10px] font-semibold uppercase tracking-wide text-blanc-pur">
          {strings.carCard.automatique}
        </span>
      )}
    </div>
  </a>
  <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
    <div class="flex items-start justify-between gap-2">
      <div>
        <p class="font-heading text-base font-bold tracking-tight text-noir-profond">{marque} {modele}</p>
        <p class="font-body text-xs uppercase tracking-wider text-noir-profond/45">{categorie}</p>
      </div>
    </div>

    <ul class="flex flex-wrap gap-x-3 gap-y-1 font-body text-xs text-noir-profond/60">
      <li>{transmission}</li>
      <li>·</li>
      <li>{carburant}</li>
      <li>·</li>
      <li>{places} {strings.vehiculeDetail.places.toLowerCase()}</li>
    </ul>

    <div class="mt-auto flex items-center justify-between border-t border-noir-profond/[0.06] pt-4">
      <p class="font-heading text-xl font-bold tracking-tight text-rouge-maroc">
        <span data-price-eur={prixParJourEUR ?? prixParJourMAD} data-price-mad={prixParJourMAD}>{prixParJourEUR ?? prixParJourMAD} €</span><span class="font-body text-xs font-normal text-noir-profond/50">{strings.carCard.jour}</span>
      </p>
      <a
        href={`/vehicule/${id}`}
        class="rounded-full border border-noir-profond/15 px-4 py-2 font-body text-xs font-semibold text-noir-profond transition-all duration-300 hover:-translate-y-0.5 hover:border-rouge-maroc hover:bg-rouge-maroc hover:text-blanc-pur hover:shadow-[0_8px_20px_-8px_rgba(200,16,46,0.5)]"
      >
        {strings.carCard.details}
      </a>
    </div>
  </div>
</article>
