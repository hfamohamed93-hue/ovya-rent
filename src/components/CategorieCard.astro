---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  nom: string;
  description: string;
  href: string;
  photos: ImageMetadata[];
  revealDelay?: number;
}

const { nom, description, href, photos, revealDelay = 0 } = Astro.props;
---

<a
  href={href}
  data-reveal
  style={`--reveal-delay: ${revealDelay}ms`}
  class="group relative overflow-hidden rounded-[12px] shadow-[0_4px_20px_-8px_rgba(17,17,17,0.15)]"
>
  <div class="relative h-40 w-full overflow-hidden" data-carousel>
    {
      photos.map((photo, i) => (
        <Image
          src={photo}
          alt=""
          width={400}
          height={260}
          class="carousel-slide absolute inset-0 h-40 w-full object-cover transition-transform duration-300 group-hover:scale-105"
          style={`opacity: ${i === 0 ? 1 : 0}`}
        />
      ))
    }
  </div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-noir-profond/85 via-noir-profond/10 to-transparent" />
  <div class="absolute inset-x-0 bottom-0 p-4">
    <p class="font-heading text-lg font-bold text-blanc-pur">{nom}</p>
    <p class="font-body text-xs text-blanc-pur/75">{description}</p>
  </div>
</a>

<script>
  let categorieCarouselIntervals: ReturnType<typeof setInterval>[] = [];

  function initCategorieCarousels() {
    categorieCarouselIntervals.forEach(clearInterval);
    categorieCarouselIntervals = [];

    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((container) => {
      const slides = Array.from(container.querySelectorAll<HTMLElement>(".carousel-slide"));
      if (slides.length <= 1) return;

      let current = 0;
      const id = setInterval(() => {
        slides[current].style.opacity = "0";
        current = (current + 1) % slides.length;
        slides[current].style.opacity = "1";
      }, 3000);
      categorieCarouselIntervals.push(id);
    });
  }

  document.addEventListener("astro:page-load", initCategorieCarousels);
</script>

<style>
  .carousel-slide {
    transition: opacity 1s ease-in-out;
  }
</style>
