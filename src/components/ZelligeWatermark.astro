---
interface Props {
  variant?: "clair" | "sombre";
}

const { variant = "clair" } = Astro.props;
const patternId = `zellige-fond-${variant}-${Math.random().toString(36).slice(2, 8)}`;
const stroke = variant === "sombre" ? "#D4AF37" : "#111111";
const opacity = variant === "sombre" ? 0.1 : 0.035;
---

<svg
  class="pointer-events-none absolute inset-0 h-full w-full"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <defs>
    <pattern id={patternId} width="110" height="110" patternUnits="userSpaceOnUse">
      <path d="M55 6 L104 55 L55 104 L6 55 Z" fill="none" stroke={stroke} stroke-width="1" opacity={opacity} />
      <path d="M55 30 L80 55 L55 80 L30 55 Z" fill="none" stroke={stroke} stroke-width="1" opacity={opacity} />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${patternId})`} />
</svg>
