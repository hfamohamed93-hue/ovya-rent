---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const vehicules = (await getCollection("vehicules")).filter((v) => v.data.disponible);

const categoriesOrdre = [
  "Citadine & Compacte",
  "Berline",
  "SUV",
  "Sport & Cabriolet",
  "Van",
] as const;
const parCategorie = categoriesOrdre.map((categorie) => ({
  categorie,
  vehicules: vehicules.filter((v) => v.data.categorie === categorie),
}));
---

<Layout
  title="Grille tarifaire"
  description="Tarifs de location de voiture OVYA Rent au Maroc, par catégorie de véhicule : économique, citadine, SUV, luxe."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h1 class="font-heading text-3xl font-bold text-noir-profond sm:text-4xl">Grille tarifaire</h1>
    <p class="mt-2 max-w-2xl font-body text-sm text-noir-profond/60">
      Tarifs indicatifs par jour, en euros (€) — basculez en dirhams marocains (MAD) via le sélecteur en haut de
      page.
    </p>

    <div class="mt-10 space-y-12">
      {
        parCategorie.map(
          ({ categorie, vehicules }) =>
            vehicules.length > 0 && (
              <div>
                <h2 class="font-heading text-xl font-bold text-noir-profond">{categorie}</h2>
                <div class="mt-4 overflow-x-auto rounded-[12px] border border-noir-profond/10">
                  <table class="w-full min-w-[560px] border-collapse font-body text-sm">
                    <thead>
                      <tr class="bg-fond text-left text-noir-profond/60">
                        <th class="px-4 py-3 font-medium">Véhicule</th>
                        <th class="px-4 py-3 font-medium">Transmission</th>
                        <th class="px-4 py-3 font-medium">Carburant</th>
                        <th class="px-4 py-3 text-right font-medium">Prix / jour</th>
                      </tr>
                    </thead>
                    <tbody>
                      {vehicules.map((v) => (
                        <tr class="border-t border-noir-profond/10">
                          <td class="px-4 py-3 font-medium text-noir-profond">
                            <a href={`/vehicule/${v.id}`} class="hover:text-rouge-maroc">
                              {v.data.marque} {v.data.modele}
                            </a>
                          </td>
                          <td class="px-4 py-3 text-noir-profond/70">{v.data.transmission}</td>
                          <td class="px-4 py-3 text-noir-profond/70">{v.data.carburant}</td>
                          <td class="px-4 py-3 text-right font-heading font-bold text-rouge-maroc">
                            <span data-price-eur={v.data.prixParJourEUR ?? v.data.prixParJourMAD} data-price-mad={v.data.prixParJourMAD}>
                              {v.data.prixParJourEUR ?? v.data.prixParJourMAD} €
                            </span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ),
        )
      }
    </div>

    <div class="mt-12 rounded-[12px] bg-fond p-6 font-body text-sm text-noir-profond/70">
      <p class="font-heading text-base font-bold text-noir-profond">Bon à savoir</p>
      <ul class="mt-3 list-disc space-y-1.5 pl-5">
        <li>Paiement sur place, à la prise en charge du véhicule.</li>
        <li>Documents requis : permis de conduire valide, passeport ou CIN — voir notre <a href="/faq" class="text-rouge-maroc hover:underline">FAQ</a>.</li>
      </ul>
    </div>
  </section>
</Layout>
